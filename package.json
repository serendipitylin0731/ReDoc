    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.15.3",
    "dompurify": "^3.4.17",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.4",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
